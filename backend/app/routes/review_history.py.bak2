"""
Review History Routes — CRUD endpoints for systematic review sessions.

All endpoints require `X-User-Id` header (auto-set by frontend).

Endpoints:
  POST   /api/review/history              — Save a completed pipeline
  GET    /api/review/history              — List MY sessions
  GET    /api/review/history/{id}         — Reload MY session
  PATCH  /api/review/history/{id}/title   — Edit MY session title
  DELETE /api/review/history/{id}         — Delete MY session
  POST   /api/review/history/{id}/report  — Attach report filename
"""
from typing import Optional

from fastapi import APIRouter, HTTPException, Header
from pydantic import BaseModel

from app.services import review_history as history


router = APIRouter(prefix="/review", tags=["review-history"])


# ─── Pydantic models ───
class SaveReviewRequest(BaseModel):
    keyword: str
    criteria: str
    lang: str = "en"
    papers: list[dict]
    duplicates_removed: int = 0
    counts: Optional[dict] = None
    report_filename: Optional[str] = None


class TitleUpdateRequest(BaseModel):
    title: str


class AttachReportRequest(BaseModel):
    report_filename: str


def _require_user_id(x_user_id: str) -> str:
    """Validate X-User-Id header."""
    if not x_user_id or len(x_user_id) < 8:
        raise HTTPException(
            status_code=400,
            detail="Missing or invalid X-User-Id header.",
        )
    return x_user_id


# ═══════════════════════════════════════════════
# ROUTE 1: Save a completed review
# ═══════════════════════════════════════════════
@router.post("/history")
async def save_review(
    req: SaveReviewRequest,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)

    if not req.papers:
        raise HTTPException(status_code=400, detail="No papers to save")

    session = history.create_session(
        user_id=user_id,
        keyword=req.keyword,
        criteria=req.criteria,
        lang=req.lang,
        papers=req.papers,
        duplicates_removed=req.duplicates_removed,
        counts=req.counts or {},
        report_filename=req.report_filename,
    )

    return {
        'status': 'success',
        'session_id': session['session_id'],
        'title': session['title'],
        'created_at': session.get('created_at_str') or session.get('created_at'),
    }


# ═══════════════════════════════════════════════
# ROUTE 2: List my sessions
# ═══════════════════════════════════════════════
@router.get("/history")
async def list_reviews(
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    items = history.list_sessions(user_id)
    return {'status': 'success', 'items': items}


# ═══════════════════════════════════════════════
# ROUTE 3: Reload one session
# ═══════════════════════════════════════════════
@router.get("/history/{session_id}")
async def get_review(
    session_id: str,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    session = history.get_session(user_id, session_id)
    if not session:
        raise HTTPException(status_code=404, detail="Session not found")

    return {
        'status': 'success',
        'session_id': session['session_id'],
        'title': session.get('title', 'Untitled'),
        'keyword': session.get('keyword', ''),
        'criteria': session.get('criteria', ''),
        'language': session.get('language', 'en'),
        'papers': session.get('papers', []),
        'duplicates_removed': session.get('duplicates_removed', 0),
        'counts': session.get('counts', {}),
        'report_filename': session.get('report_filename'),
        'created_at': session.get('created_at_str') or session.get('created_at'),
        'updated_at': session.get('created_at_str') or session.get('created_at'),
    }


# ═══════════════════════════════════════════════
# ROUTE 4: Edit title
# ═══════════════════════════════════════════════
@router.patch("/history/{session_id}/title")
async def edit_title(
    session_id: str,
    req: TitleUpdateRequest,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    session = history.get_session(user_id, session_id)
    if not session:
        raise HTTPException(status_code=404, detail="Session not found")

    updated = history.update_title(user_id, session_id, req.title)
    if not updated:
        raise HTTPException(status_code=404, detail="Session not found")
    return {'status': 'success', 'title': updated.get('title', '')}


# ═══════════════════════════════════════════════
# ROUTE 5: Attach a report
# ═══════════════════════════════════════════════
@router.post("/history/{session_id}/report")
async def attach_report(
    session_id: str,
    req: AttachReportRequest,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    session = history.get_session(user_id, session_id)
    if not session:
        raise HTTPException(status_code=404, detail="Session not found")

    ok = history.attach_report(user_id, session_id, req.report_filename)
    if not ok:
        raise HTTPException(status_code=404, detail="Session not found")
    return {'status': 'success', 'report_filename': req.report_filename}


# ═══════════════════════════════════════════════
# ROUTE 6: Delete a session
# ═══════════════════════════════════════════════
@router.delete("/history/{session_id}")
async def delete_review(
    session_id: str,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    session = history.get_session(user_id, session_id)
    if not session:
        raise HTTPException(status_code=404, detail="Session not found")

    history.delete_session(user_id, session_id)
    return {'status': 'success', 'deleted': session_id}