"""
Presentation Routes — Generate PPTX + PDF slide decks from user content.
Full history system: save / reload / delete / title edit / download.

All history endpoints require `X-User-Id` header.
"""
import os
from typing import Optional

from fastapi import APIRouter, HTTPException, UploadFile, File, Header
from fastapi.responses import FileResponse
from pydantic import BaseModel

from app.services import presentation_history as history
from app.services.ppt_generator import generate_pptx
from app.services.pdf_generator import generate_pdf


router = APIRouter(prefix="/presentation", tags=["presentation"])


GENERATED_DIR = os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
    'generated',
    'presentations'
)
os.makedirs(GENERATED_DIR, exist_ok=True)


# ─── Pydantic models ───
class PresentationRequest(BaseModel):
    content: str
    title: Optional[str] = None
    lang: Optional[str] = 'en'


class TitleUpdateRequest(BaseModel):
    title: str


def _require_user_id(x_user_id: str) -> str:
    if not x_user_id or len(x_user_id) < 8:
        raise HTTPException(
            status_code=400,
            detail="Missing or invalid X-User-Id header.",
        )
    return x_user_id


# ─── Helper ───
def _generate_files(session_id, slides_data):
    """Generate both PPTX and PDF for a session and return filenames."""
    pptx_filename = f"{session_id}.pptx"
    pdf_filename = f"{session_id}.pdf"

    pptx_path = os.path.join(GENERATED_DIR, pptx_filename)
    pdf_path = os.path.join(GENERATED_DIR, pdf_filename)

    generate_pptx(slides_data, pptx_path)
    generate_pdf(slides_data, pdf_path)

    return pptx_filename, pdf_filename


# ═══════════════════════════════════════════════
# ROUTE 1: Generate from pasted content
# ═══════════════════════════════════════════════
@router.post("/generate")
async def generate_presentation(
    req: PresentationRequest,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    """Generate a presentation from pasted content."""
    user_id = _require_user_id(x_user_id)

    if not req.content or not req.content.strip():
        raise HTTPException(status_code=400, detail="Content is required")

    session = history.create_session(
        user_id=user_id,
        content=req.content,
        title_hint=req.title,
        lang=req.lang or 'en',
    )

    slides_data = {
        'title': session['title'],
        'subtitle': session.get('subtitle', ''),
        'slides': session.get('slides', []),
    }

    sid = session['session_id']
    try:
        pptx_file, pdf_file = _generate_files(sid, slides_data)
        history.update_files(user_id, sid, pptx_file=pptx_file, pdf_file=pdf_file)
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"File generation failed: {e}")

    return {
        'status': 'success',
        'session_id': sid,
        'title': session['title'],
        'subtitle': session.get('subtitle', ''),
        'slides': session.get('slides', []),
        'pptx_url': f"/api/presentation/download/{sid}/pptx",
        'pdf_url': f"/api/presentation/download/{sid}/pdf",
        'created_at': session.get('created_at'),
    }


# ═══════════════════════════════════════════════
# ROUTE 2: Upload a file (txt / md) and generate
# ═══════════════════════════════════════════════
@router.post("/upload")
async def upload_and_generate(
    file: UploadFile = File(...),
    title: Optional[str] = None,
    lang: Optional[str] = 'en',
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    """Upload a .txt or .md file and generate a presentation."""
    user_id = _require_user_id(x_user_id)

    filename = (file.filename or '').lower()
    if not (filename.endswith('.txt') or filename.endswith('.md')):
        raise HTTPException(
            status_code=400,
            detail="Only .txt or .md files are supported here. Use /api/upload for PDFs."
        )

    raw = await file.read()
    try:
        content = raw.decode('utf-8', errors='ignore')
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Could not read file: {e}")

    if not content.strip():
        raise HTTPException(status_code=400, detail="File is empty")

    # Directly call service (skip HTTP round-trip)
    session = history.create_session(
        user_id=user_id,
        content=content,
        title_hint=title or file.filename,
        lang=lang or 'en',
    )

    slides_data = {
        'title': session['title'],
        'subtitle': session.get('subtitle', ''),
        'slides': session.get('slides', []),
    }

    sid = session['session_id']
    try:
        pptx_file, pdf_file = _generate_files(sid, slides_data)
        history.update_files(user_id, sid, pptx_file=pptx_file, pdf_file=pdf_file)
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"File generation failed: {e}")

    return {
        'status': 'success',
        'session_id': sid,
        'title': session['title'],
        'subtitle': session.get('subtitle', ''),
        'slides': session.get('slides', []),
        'pptx_url': f"/api/presentation/download/{sid}/pptx",
        'pdf_url': f"/api/presentation/download/{sid}/pdf",
        'created_at': session.get('created_at'),
    }


# ═══════════════════════════════════════════════
# ROUTE 3: List MY history
# ═══════════════════════════════════════════════
@router.get("/history")
async def list_history(
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    items = history.list_sessions(user_id)
    return {'status': 'success', 'items': items}


# ═══════════════════════════════════════════════
# ROUTE 4: Load one of MY sessions
# ═══════════════════════════════════════════════
@router.get("/history/{session_id}")
async def get_history_session(
    session_id: str,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    session = history.get_session(user_id, session_id)
    if not session:
        raise HTTPException(status_code=404, detail="Session not found")

    sid = session['session_id']
    return {
        'status': 'success',
        'session_id': sid,
        'title': session['title'],
        'subtitle': session.get('subtitle', ''),
        'slides': session.get('slides', []),
        'raw_content': session.get('raw_content', ''),
        'language': session.get('language', 'en'),
        'created_at': session.get('created_at'),
        'updated_at': session.get('updated_at'),
        'pptx_url': (
            f"/api/presentation/download/{sid}/pptx"
            if session.get('pptx_file') else None
        ),
        'pdf_url': (
            f"/api/presentation/download/{sid}/pdf"
            if session.get('pdf_file') else None
        ),
    }


# ═══════════════════════════════════════════════
# ROUTE 5: Edit MY title
# ═══════════════════════════════════════════════
@router.patch("/history/{session_id}/title")
async def edit_title(
    session_id: str,
    req: TitleUpdateRequest,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    updated = history.update_title(user_id, session_id, req.title)
    if not updated:
        raise HTTPException(status_code=404, detail="Session not found")
    return {'status': 'success', 'title': updated.get('title', '')}


# ═══════════════════════════════════════════════
# ROUTE 6: Delete MY session + its files
# ═══════════════════════════════════════════════
@router.delete("/history/{session_id}")
async def delete_history_session(
    session_id: str,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    session = history.get_session(user_id, session_id)
    if not session:
        raise HTTPException(status_code=404, detail="Session not found")

    removed_files = history.delete_session(user_id, session_id)
    for fname in removed_files:
        fpath = os.path.join(GENERATED_DIR, fname)
        if os.path.exists(fpath):
            try:
                os.remove(fpath)
            except OSError as e:
                print(f'[presentation] File delete failed: {fpath} — {e}')

    return {'status': 'success', 'deleted': session_id}


# ═══════════════════════════════════════════════
# ROUTE 7: Download generated file
# ═══════════════════════════════════════════════
@router.get("/download/{session_id}/{fmt}")
async def download_file(session_id: str, fmt: str):
    """
    Download the PPTX or PDF for a session.
    No X-User-Id required — file names are UUID-based (unguessable).
    """
    if fmt not in ('pptx', 'pdf'):
        raise HTTPException(status_code=400, detail="Format must be pptx or pdf")

    if not os.path.exists(GENERATED_DIR):
        raise HTTPException(status_code=404, detail="File not found")

    # Search all users' sessions for this session_id
    # (session_id itself is a UUID, so it's already unguessable)
    all_users_session = None
    for fname in os.listdir(GENERATED_DIR):
        if fname.startswith(session_id) and fname.endswith(f".{fmt}"):
            all_users_session = fname
            break

    if not all_users_session:
        raise HTTPException(status_code=404, detail="File not found on disk")

    file_path = os.path.join(GENERATED_DIR, all_users_session)
    media_type = (
        'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        if fmt == 'pptx'
        else 'application/pdf'
    )

    return FileResponse(
        file_path,
        media_type=media_type,
        filename=f"{session_id}.{fmt}",
    )