"""
Quiz routes — generate quizzes + per-user isolated history.

All history endpoints require `X-User-Id` header.

Endpoints:
  POST   /api/quiz                       Generate a quiz
  GET    /api/quiz/history               List MY quiz sessions
  GET    /api/quiz/history/{id}          Get one of MY sessions
  POST   /api/quiz/history/{id}/answers  Save MY answers progress
  POST   /api/quiz/history/{id}/score    Mark completed & save score
  PATCH  /api/quiz/history/{id}/title    Update MY session title
  DELETE /api/quiz/history/{id}          Delete one of MY sessions
  DELETE /api/quiz/history               Clear all MY sessions
"""
from fastapi import APIRouter, HTTPException, Header
from pydantic import BaseModel
from typing import List, Optional

from app.services.gemini_client import generate_quiz, _generate_session_title
from app.services import quiz_history


router = APIRouter()


class QuizRequest(BaseModel):
    context_text: str
    num_questions: int = 5
    lang: str = "en"
    source: str = "pasted"


class AnswersRequest(BaseModel):
    answers: List[Optional[int]]


class ScoreRequest(BaseModel):
    correct: int
    total: int


class TitleUpdateRequest(BaseModel):
    title: str


def _require_user_id(x_user_id: str) -> str:
    if not x_user_id or len(x_user_id) < 8:
        raise HTTPException(
            status_code=400,
            detail="Missing or invalid X-User-Id header.",
        )
    return x_user_id


@router.post("/quiz")
async def create_quiz(
    req: QuizRequest,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    """Generate a quiz from content and save to MY history."""
    user_id = _require_user_id(x_user_id)

    if not req.context_text or not req.context_text.strip():
        raise HTTPException(status_code=400, detail="Context text is required")

    result = generate_quiz(req.context_text, req.num_questions, req.lang)

    if not result.get("questions"):
        raise HTTPException(
            status_code=500,
            detail=result.get("error", "Quiz generation failed"),
        )

    # Auto-generate a session title
    try:
        title = _generate_session_title(req.context_text, req.lang)
    except Exception:
        title = f"Quiz ({req.num_questions} questions)"

    # Save to history
    session = quiz_history.create_session(
        user_id=user_id,
        title=title,
        content=req.context_text,
        source=req.source,
        num_questions=req.num_questions,
        questions=result["questions"],
    )

    return {
        "status": "success",
        "questions": result["questions"],
        "session_id": session["session_id"],
        "title": title,
    }


@router.get("/quiz/history")
async def get_quiz_history(
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    return {"sessions": quiz_history.list_sessions(user_id)}


@router.get("/quiz/history/{session_id}")
async def get_quiz_session(
    session_id: str,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    session = quiz_history.get_session(user_id, session_id)
    if not session:
        raise HTTPException(status_code=404, detail="Session not found")
    return session


@router.post("/quiz/history/{session_id}/answers")
async def save_quiz_answers(
    session_id: str,
    req: AnswersRequest,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    session = quiz_history.save_answers(user_id, session_id, req.answers)
    if not session:
        raise HTTPException(status_code=404, detail="Session not found")
    return {"status": "success"}


@router.post("/quiz/history/{session_id}/score")
async def save_quiz_score(
    session_id: str,
    req: ScoreRequest,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    session = quiz_history.save_score(user_id, session_id, req.correct, req.total)
    if not session:
        raise HTTPException(status_code=404, detail="Session not found")
    return {"status": "success", "score": session.get("score")}


@router.patch("/quiz/history/{session_id}/title")
async def update_quiz_title(
    session_id: str,
    req: TitleUpdateRequest,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    ok = quiz_history.update_title(user_id, session_id, req.title.strip())
    if not ok:
        raise HTTPException(status_code=404, detail="Session not found")
    return {"status": "success", "title": req.title.strip()}


@router.delete("/quiz/history/{session_id}")
async def delete_quiz_session(
    session_id: str,
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    ok = quiz_history.delete_session(user_id, session_id)
    if not ok:
        raise HTTPException(status_code=404, detail="Session not found")
    return {"status": "success", "deleted": session_id}


@router.delete("/quiz/history")
async def clear_quiz_history(
    x_user_id: str = Header(..., alias="X-User-Id"),
):
    user_id = _require_user_id(x_user_id)
    count = quiz_history.clear_all(user_id)
    return {"status": "success", "deleted_count": count}