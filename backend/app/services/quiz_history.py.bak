"""
Quiz History Manager — per-user isolated JSON storage.

Each session has:
  - session_id, user_id
  - title: AI-generated title
  - content: full paper text
  - content_preview: first 200 chars
  - source: 'pasted' | 'uploaded'
  - num_questions
  - questions: [{question, options, correct_index, explanation}]
  - answers: user's selected answers
  - score: {correct, total, percentage} after completion
  - completed: bool

Storage: backend/app/data/quiz_history.json (via HistoryStore)
"""
from datetime import datetime
from typing import Optional

from app.services.history_store import quiz_history_store as _store


def list_sessions(user_id: str) -> list:
    """Lightweight list — no content or questions."""
    summary = []
    for s in _store.list_sessions(user_id):
        summary.append({
            "id": s.get("session_id"),
            "title": s.get("title", "Untitled Quiz"),
            "content_preview": s.get("content_preview", ""),
            "source": s.get("source", "pasted"),
            "num_questions": s.get("num_questions", 0),
            "created_at": s.get("created_at"),
            "updated_at": s.get("updated_at") or s.get("created_at"),
            "score": s.get("score"),
            "completed": s.get("completed", False),
        })
    summary.sort(key=lambda x: str(x.get("updated_at", "")), reverse=True)
    return summary


def get_session(user_id: str, session_id: str) -> Optional[dict]:
    """Return full session including questions & answers."""
    return _store.get_session(user_id, session_id)


def create_session(
    user_id: str,
    title: str = "New Quiz",
    content: str = "",
    source: str = "pasted",
    num_questions: int = 5,
    questions: list = None,
) -> dict:
    """Create a new quiz session with generated questions."""
    now = datetime.utcnow().isoformat() + "Z"
    content_preview = content[:200].replace("\n", " ").strip()
    data = {
        "title": (title or "New Quiz")[:80],
        "content": content,
        "content_preview": content_preview,
        "source": source,
        "num_questions": num_questions,
        "created_at": now,
        "updated_at": now,
        "questions": questions or [],
        "answers": [None] * (num_questions if not questions else len(questions)),
        "score": None,
        "completed": False,
    }
    record = _store.save_session(user_id, data)
    print(f"[quiz-history] Created session: {record['session_id']} — {title}")
    return record


def save_answers(user_id: str, session_id: str, answers: list) -> Optional[dict]:
    """Save user's answers."""
    session = _store.get_session(user_id, session_id)
    if not session:
        return None
    session["answers"] = answers
    session["updated_at"] = datetime.utcnow().isoformat() + "Z"
    return _store.save_session(user_id, session)


def save_score(user_id: str, session_id: str, correct: int, total: int) -> Optional[dict]:
    """Mark quiz as completed and store score."""
    session = _store.get_session(user_id, session_id)
    if not session:
        return None
    percentage = round((correct / total) * 100) if total > 0 else 0
    session["score"] = {
        "correct": correct,
        "total": total,
        "percentage": percentage,
    }
    session["completed"] = True
    session["updated_at"] = datetime.utcnow().isoformat() + "Z"
    _store.save_session(user_id, session)
    print(f"[quiz-history] Score saved: {correct}/{total} ({percentage}%)")
    return session


def update_title(user_id: str, session_id: str, new_title: str) -> bool:
    """Update quiz session title."""
    return _store.rename_session(user_id, session_id, (new_title or "").strip()[:80])


def delete_session(user_id: str, session_id: str) -> bool:
    """Delete one quiz session."""
    return _store.delete_session(user_id, session_id)


def clear_all(user_id: str) -> int:
    """Delete all quiz sessions for user_id."""
    sessions = _store.list_sessions(user_id)
    count = 0
    for s in sessions:
        if _store.delete_session(user_id, s.get("session_id")):
            count += 1
    return count