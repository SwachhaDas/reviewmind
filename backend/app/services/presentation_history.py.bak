"""
Presentation History — per-user isolated JSON storage.

Stores:
  - session_id, user_id
  - title (user-editable)
  - raw content (full, no truncation)
  - slide data
  - pptx / pdf filenames
  - created_at / updated_at

Storage: backend/app/data/presentation_history.json (via HistoryStore)
"""
from datetime import datetime

from app.services.history_store import presentation_history_store as _store
from app.services.slide_generator import generate_slide_data


def create_session(user_id: str, content: str, title_hint: str = None, lang: str = 'en') -> dict:
    """
    Create a new presentation session:
      1. Call Gemini to generate slide data.
      2. Save session with slide data + raw content.
    """
    slide_data = generate_slide_data(content, title_hint, lang)
    now = datetime.utcnow().isoformat() + "Z"

    data = {
        "title": slide_data.get("title", title_hint or "Presentation"),
        "subtitle": slide_data.get("subtitle", ""),
        "slides": slide_data.get("slides", []),
        "raw_content": content,
        "language": lang,
        "created_at": now,
        "updated_at": now,
        "pptx_file": None,
        "pdf_file": None,
    }
    record = _store.save_session(user_id, data)
    return record


def update_files(user_id: str, session_id: str, pptx_file: str = None, pdf_file: str = None):
    """Attach generated file names to a session."""
    session = _store.get_session(user_id, session_id)
    if not session:
        return False
    if pptx_file:
        session["pptx_file"] = pptx_file
    if pdf_file:
        session["pdf_file"] = pdf_file
    session["updated_at"] = datetime.utcnow().isoformat() + "Z"
    _store.save_session(user_id, session)
    return True


def get_session(user_id: str, session_id: str):
    """Retrieve one session."""
    return _store.get_session(user_id, session_id)


def list_sessions(user_id: str) -> list:
    """Lightweight list for the sidebar."""
    items = []
    for s in _store.list_sessions(user_id):
        items.append({
            "id": s.get("session_id"),
            "title": s.get("title", "Untitled"),
            "subtitle": s.get("subtitle", ""),
            "slide_count": len(s.get("slides", [])),
            "language": s.get("language", "en"),
            "created_at": s.get("created_at"),
            "updated_at": s.get("updated_at") or s.get("created_at"),
            "has_pptx": bool(s.get("pptx_file")),
            "has_pdf": bool(s.get("pdf_file")),
        })
    items.sort(key=lambda x: str(x.get("updated_at", "")), reverse=True)
    return items


def delete_session(user_id: str, session_id: str):
    """
    Delete a session. Returns list of filenames to delete
    so the caller can remove the generated .pptx/.pdf files.
    """
    session = _store.get_session(user_id, session_id)
    if not session:
        return []
    removed = []
    if session.get("pptx_file"):
        removed.append(session["pptx_file"])
    if session.get("pdf_file"):
        removed.append(session["pdf_file"])
    _store.delete_session(user_id, session_id)
    return removed


def update_title(user_id: str, session_id: str, new_title: str):
    """Update the title of a session."""
    ok = _store.rename_session(user_id, session_id, (new_title or "").strip())
    if not ok:
        return None
    return _store.get_session(user_id, session_id)