"""
Chat History Manager — per-user isolated JSON storage.

Each session has:
  - session_id: unique session id
  - user_id: owner (required for privacy isolation)
  - title: derived from paper title or AI-generated
  - paper_title: title of loaded paper (if any)
  - source: 'uploaded' | 'pasted' | 'free'
  - created_at / updated_at
  - messages: [{role, text, time}]
  - paper_data: {full_text, abstract, introduction, ...}

Storage: backend/app/data/chat_history.json (via HistoryStore)
"""
from datetime import datetime
from typing import Optional

from app.services.history_store import chat_history_store as _store


# ─────────────────────────────────────────────────────────────
# Public API
# ─────────────────────────────────────────────────────────────

def list_sessions(user_id: str) -> list:
    """Lightweight list of sessions belonging to user_id (no messages)."""
    summary = []
    for s in _store.list_sessions(user_id):
        summary.append({
            "id": s.get("session_id"),
            "title": s.get("title", "Untitled"),
            "paper_title": s.get("paper_title", ""),
            "source": s.get("source", "free"),
            "created_at": s.get("created_at"),
            "updated_at": s.get("updated_at") or s.get("created_at"),
            "message_count": len(s.get("messages", [])),
        })
    summary.sort(key=lambda x: x.get("updated_at", ""), reverse=True)
    return summary


def get_session(user_id: str, session_id: str) -> Optional[dict]:
    """Return one full session or None (must belong to user_id)."""
    return _store.get_session(user_id, session_id)


def create_session(
    user_id: str,
    title: str = "New Chat",
    paper_title: str = "",
    source: str = "free",
    paper_data: dict = None,
) -> dict:
    """Create a new session."""
    now = datetime.utcnow().isoformat() + "Z"
    data = {
        "title": (title or "New Chat")[:80],
        "paper_title": (paper_title or "")[:200],
        "source": source,
        "created_at": now,
        "updated_at": now,
        "messages": [],
        "paper_data": paper_data or {},
    }
    record = _store.save_session(user_id, data)
    print(f"[history] Created session: {record['session_id']} — {title}")
    return record


def append_message(user_id: str, session_id: str, role: str, text: str) -> Optional[dict]:
    """Append a message to a session (must belong to user_id)."""
    session = _store.get_session(user_id, session_id)
    if not session:
        return None
    session.setdefault("messages", []).append({
        "role": role,
        "text": text,
        "time": datetime.utcnow().isoformat() + "Z",
    })
    session["updated_at"] = datetime.utcnow().isoformat() + "Z"
    return _store.save_session(user_id, session)


def update_session_title(user_id: str, session_id: str, new_title: str) -> bool:
    """Update a session's title."""
    return _store.rename_session(user_id, session_id, (new_title or "").strip()[:80])


def update_session_paper_data(user_id: str, session_id: str, paper_data: dict) -> bool:
    """Attach paper_data to a session."""
    session = _store.get_session(user_id, session_id)
    if not session:
        return False
    session["paper_data"] = paper_data
    session["updated_at"] = datetime.utcnow().isoformat() + "Z"
    _store.save_session(user_id, session)
    return True


def delete_session(user_id: str, session_id: str) -> bool:
    """Delete one session."""
    return _store.delete_session(user_id, session_id)


def clear_all(user_id: str) -> int:
    """Delete all sessions for user_id. Returns count deleted."""
    sessions = _store.list_sessions(user_id)
    count = 0
    for s in sessions:
        if _store.delete_session(user_id, s.get("session_id")):
            count += 1
    print(f"[history] Cleared {count} sessions for user {user_id[:8]}...")
    return count